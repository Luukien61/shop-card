<?import javafx.scene.layout.Region?>
<TabPane fx:id="tabPane" minHeight="-Infinity" minWidth="-Infinity" prefHeight="520.0" prefWidth="650.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.luukien.javacard.controller.HomeManagementController">
    <tabs>
        <Tab fx:id="orderPaneTab" text="Hoá đơn">
            <content>
                <AnchorPane prefHeight="500.0" prefWidth="650.0" style="-fx-background-color: #ffffff;">
                    <children>
                        <Button fx:id="createOrderBtn" alignment="CENTER" defaultButton="true" layoutX="246.0" layoutY="428.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="105.0" style="-fx-background-color: #0866FF;" text="Tạo đơn mới" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                            <effect>
                                <Glow level="0.34" />
                            </effect>
                        </Button>
                        <DatePicker fx:id="orderdatePicker" layoutX="94.0" layoutY="90.0" prefHeight="30.0" prefWidth="179.0" promptText="dd/mm/yyyy" />
                        <TableView fx:id="orderTable" layoutX="29.0" layoutY="131.0" prefHeight="271.0" prefWidth="591.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #EBEBEB;">
                            <columns>
                                <TableColumn fx:id="colOrderIndex" prefWidth="36.666656494140625" text="ID" />
                                <TableColumn fx:id="colOrderId" prefWidth="114.0" text="Mã đơn hàng" />
                                <TableColumn fx:id="colUserPhone" prefWidth="102.6666259765625" text="Số điện thoại" />
                                <TableColumn fx:id="colTotalPrice" prefWidth="107.3333740234375" text="Tổng tiền" />
                                <TableColumn fx:id="colTime" prefWidth="142.6666259765625" text="Thời gian mua" />
                                <TableColumn fx:id="colDetail" prefWidth="95.33331298828125" text="Chi tiết" />
                            </columns>
                        </TableView>
                        <Label layoutX="31.0" layoutY="93.0" text="Ngày">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label layoutX="26.0" layoutY="28.0" prefHeight="32.0" prefWidth="597.0" style="-fx-background-color: #0866FF; -fx-background-radius: 8;" text="Đơn hàng " textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Label>
                        <Button fx:id="filterOrderBtn" onAction="#onFilterOrder" layoutX="318.0" layoutY="90.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="65.0" text="Lọc">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </AnchorPane>
            </content>
        </Tab>
        <Tab fx:id="productPaneTab" text="Sản phẩm">
            <content>
                <AnchorPane prefHeight="500.0" prefWidth="650.0" style="-fx-background-color: #FFFFFF;">
                    <children>
                        <TableView fx:id="productTable" layoutX="33.0" layoutY="145.0" prefHeight="280.0" prefWidth="590.0">
                            <columns>
                                <TableColumn fx:id="colProductId" prefWidth="40.666656494140625" text="ID" />
                                <TableColumn fx:id="colProductName" prefWidth="173.99999237060547" text="Tên sản phẩm" />
                                <TableColumn fx:id="colProductCode" prefWidth="144.6666717529297" text="Mã sản phẩm" />
                                <TableColumn fx:id="colPrice" prefWidth="132.66671752929688" text="Giá" />
                                <TableColumn fx:id="colRemain" minWidth="0.0" prefWidth="95.99993896484375" text="Số lượng kho" />
                            </columns>
                        </TableView>
                        <Button fx:id="addNewProductBtn" disable="true" layoutX="280.0" layoutY="442.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: #0866FF;" text="Thêm  mới" textFill="WHITE" visible="false">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Label layoutX="26.0" layoutY="30.0" prefHeight="32.0" prefWidth="597.0" style="-fx-background-color: #0866FF; -fx-background-radius: 8;" text="Sản phẩm" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Label>
                        <TextField fx:id="productFilterTextField" layoutX="33.0" layoutY="90.0" prefHeight="29.0" prefWidth="267.0" promptText="Tên, mã sản phẩm">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </TextField>
                        <Button fx:id="filterProductBtn" layoutX="328.0" layoutY="90.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="63.0" text="Lọc">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </AnchorPane>
            </content>
        </Tab>
        <Tab fx:id="userPaneTab" text="Khách hàng">
            <content>
                <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="650.0">
                    <children>
                        <TableView fx:id="userTable" layoutX="26.0" layoutY="115.0" prefHeight="295.0" prefWidth="597.0">
                            <columns>
                                <TableColumn fx:id="colUserName" prefWidth="150.66665077209473" text="Họ và tên" />
                                <TableColumn fx:id="colPhone" prefWidth="148.0000457763672" text="Số điện thoại" />
                                <TableColumn fx:id="colClass" prefWidth="90.6666259765625" text="Hạng " />
                                <TableColumn fx:id="colAddress" prefWidth="161.33328247070312" text="Địa chỉ" />
                            </columns>
                        </TableView>
                        <Label layoutX="26.0" layoutY="25.0" prefHeight="32.0" prefWidth="597.0" style="-fx-background-color: #0866FF; -fx-background-radius: 8;" text="     Danh sách khách hàng " textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="userFilterTextField" layoutX="26.0" layoutY="72.0" prefHeight="25.0" prefWidth="237.0" promptText="Họ tên, số điện thoại">
                     <font>
                        <Font size="14.0" />
                     </font></TextField>
                        <Button fx:id="searchUserBtn" layoutX="300.0" layoutY="72.0" mnemonicParsing="false" prefHeight="29.0" prefWidth="83.0" text="Tìm kiếm">
                     <font>
                        <Font size="14.0" />
                     </font></Button>
                        <Button fx:id="addNewUserBtn" disable="true" layoutX="299.0" layoutY="432.0" mnemonicParsing="false" style="-fx-background-color: #0866FF;" text="Thêm mới" textFill="WHITE" visible="false">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </AnchorPane>
            </content>
        </Tab>
        <Tab text="Tài khoản">
            <content>
                <AnchorPane prefHeight="500.0" prefWidth="650.0" style="-fx-background-color: #F5F7FA;">
                    <children>
                        <!-- Account Info Card -->
                        <VBox layoutX="20.0" layoutY="20.0" prefWidth="610.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2); -fx-padding: 25;">
                            <children>
                                <Label text="Thông tin tài khoản" textFill="#1F2937">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>

                                <HBox spacing="30.0">
                                    <children>
                                        <!-- Left: Account Details -->
                                        <GridPane hgap="15.0" prefWidth="380.0" style="-fx-background-color: #F9FAFB; -fx-background-radius: 10; -fx-padding: 20;" vgap="15.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                            </rowConstraints>
                                            <children>
                                                <Label text="Email" textFill="#374151">
                                                    <font>
                                                        <Font name="System Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                                <Label text="Password" textFill="#374151" GridPane.rowIndex="1">
                                                    <font>
                                                        <Font name="System Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="pinLabel" text="PIN" textFill="#374151" GridPane.rowIndex="2">
                                                    <font>
                                                        <Font name="System Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="emailLabel" text="Label" textFill="#1F2937" GridPane.columnIndex="1">
                                                    <font>
                                                        <Font size="13.0" />
                                                    </font>
                                                </Label>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                    <children>
                                                        <Label text="••••••••" textFill="#1F2937">
                                                            <font>
                                                                <Font size="13.0" />
                                                            </font>
                                                        </Label>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="updatePasswordBtn" prefWidth="80" mnemonicParsing="false" style="-fx-background-color: #3B82F6; -fx-background-radius: 6; -fx-cursor: hand;" text="Thay đổi" textFill="WHITE">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                            <padding>
                                                                <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
                                                            </padding>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                    <children>
                                                        <Label fx:id="pinPhLabel" text="••••••" textFill="#1F2937">
                                                            <font>
                                                                <Font size="13.0" />
                                                            </font>
                                                        </Label>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="viewPinBtn" prefWidth="80" mnemonicParsing="false" style="-fx-background-color: #10B981; -fx-background-radius: 6; -fx-cursor: hand;" text="Xem" textFill="WHITE">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                            <padding>
                                                                <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
                                                            </padding>
                                                        </Button>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </GridPane>

                                        <!-- Right: Avatar -->
                                        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #F9FAFB; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #E5E7EB; -fx-border-radius: 12; -fx-border-width: 2;">
                                            <children>
                                                <Label text="Ảnh đại diện" textFill="#374151">
                                                    <font>
                                                        <Font name="System Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                                <ImageView fx:id="imgView" fitHeight="150.0" fitWidth="136.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 2);">
                                                    <image>
                                                        <Image url="@img/default-avatar.jpg" />
                                                    </image>
                                                </ImageView>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Logout Button -->
                        <Button fx:id="logoutBtn" layoutX="252.0" layoutY="350.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="145.0" style="-fx-background-color: #DC3545; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(220,53,69,0.3), 8, 0, 0, 3);" text="🚪 Đăng xuất" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </AnchorPane>
            </content>
        </Tab>
    </tabs>
</TabPane>
